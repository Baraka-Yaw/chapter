# Postgres. Locally: createdb chapter_o. On Vercel: add Neon from Storage and it sets DATABASE_URL.
DATABASE_URL=postgres://localhost:5432/chapter_o

# Admin sign-in at /admin. Use a long password and a random 32+ character secret
# (e.g. `openssl rand -base64 32`).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob for product photos. On Vercel: add Blob from Storage and it sets this.
# Locally: `vercel env pull` or copy it from the Blob store's settings. Optional.
BLOB_READ_WRITE_TOKEN=

# Public shop address for share links and previews, e.g. https://chapteroweare.com.
# Optional on Vercel: the production domain is used automatically.
NEXT_PUBLIC_SITE_URL=
